# Configuración de 1GLOBAL API
# Copia este archivo como `.env` (excluido de Git) y completa los valores.
# El token se lee de GLOBAL_API (alias: ONEGLOBAL_TOKEN, por compatibilidad).
ONEGLOBAL_BASE_URL=https://iot.truphone.com/api
GLOBAL_API=
ONEGLOBAL_AUTH_SCHEME=Token
ONEGLOBAL_MODE=replay

# Dispositivo Teltonika de pruebas
TELTONIKA_TEST_IMEI=
ONEGLOBAL_TEST_ICCID=

# MCP
MCP_SERVER_NAME=oneglobal-sms
MCP_TRANSPORT=stdio
# El transporte por red (streamable-http/sse) EXIGE TLS; generálolo con:
#   python main.py gen-certs
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=8000
MCP_TLS_CERTFILE=
MCP_TLS_KEYFILE=

# Ejecución SMS
SMS_DRY_RUN=true
SMS_LIVE_ENABLED=false
SMS_REQUIRE_CONFIRMATION=true

# HTTP
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
ONEGLOBAL_RATE_LIMIT_PER_MINUTE=100

# Sondeo SMS
SMS_POLL_INTERVAL_SECONDS=5
SMS_SENT_GRACE_SECONDS=600
SMS_RESPONSE_WINDOW_SECONDS=3600
SMS_POLL_MAX_AGE_SECONDS=86400
SMS_MAX_RETRIES=3

# Persistencia
DATABASE_PATH=./data/sms_tasks.db

# Registro
LOG_LEVEL=INFO
