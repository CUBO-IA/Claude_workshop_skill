# Credenciales 1GLOBAL (Truphone IoT Portal)
# ---------------------------------------------------------------------------
# Plantilla pública (SÍ se versiona en git). Copia este archivo como `.env`
# y reemplaza los valores con tus credenciales reales.
#
# GLOBAL_API: token de la API de 1GLOBAL. Se envía como
#             `Authorization: Token <GLOBAL_API>` (NO Bearer).
GLOBAL_API=

# IMEI_PRUEBAS: llave Device de pruebas para enviar SMS de prueba.
#               Sin el dígito verificador final, 14 dígitos.
IMEI_PRUEBAS=

# ICCID_PRUEBAS: ICCID de la SIM de pruebas (19–20 dígitos, inicia con 8944…).
ICCID_PRUEBAS=
